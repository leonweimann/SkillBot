# Discord-Bot-Token (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=dein-discord-bot-token

# Optional: nur für die Kalender-Automatik (Microsoft Entra App, siehe README)
# Application (client) ID der App-Registrierung
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Directory (tenant) ID des Microsoft-365-Mandanten
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
